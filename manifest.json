{
  "manifest_version": 3,
  "name": "X Headline Link Details",
  "version": "1.0.2",
  "description": "Adds aria-label and href details to restored headline links on x.com.",
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["infoSvg.html", "infoPopup.html"],
      "matches": ["https://x.com/*", "https://www.x.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
